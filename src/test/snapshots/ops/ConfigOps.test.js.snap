              "password",
            ],
          },
          "type": "groovy",
        },
        "enabled": {
          "$bool": "&{openidm.notifications.passwordUpdate|false}",
        },
        "methods": [
          "update",
          "patch",
        ],
        "notification": {
          "message": "Your password has been updated.",
          "notificationType": "info",
        },
        "path": "managed/user/*",
        "target": {
          "resource": "managed/user/{{response/_id}}",
        },
      },
