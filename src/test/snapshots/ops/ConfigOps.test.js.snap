                ],
                "script": [
                  "logger.info("This is exclusive gateway");",
                ],
              },
              "type": "scriptTask",
            },
            {
              "displayName": "Auto-Reject - Validation Failed",
              "name": "scriptTask-449aac6b18b8",
              "scriptTask": {
                "language": "javascript",
                "nextStep": [
                  {
                    "condition": [
                      "true",
