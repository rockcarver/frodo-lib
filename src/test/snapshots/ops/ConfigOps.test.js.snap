                    "    ",
                    "    return [{",
                    "        "id": "managed/user/" + certifierId,",
                    "        "permissions": {",
                    "            "fulfill": true,",
                    "            "deny": true,",
                    "            "reassign": true,",
                    "            "modify": true,",
                    "            "comment": true",
                    "        }",
                    "    }];",
                    "})()",
                    "",
                  ],
                },
                "approvalMode": "any",
                "events": {
                  "assignment": {
                    "notification": "requestAssigned",
                  },
                  "expiration": {
