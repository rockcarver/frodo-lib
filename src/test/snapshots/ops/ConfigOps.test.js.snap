          "context": "DEVICE_MATCH_NODE",
          "createdBy": "id=dsameuser,ou=user,dc=openam,dc=forgerock,dc=org",
          "creationDate": 1433147666269,
          "default": true,
          "description": "Default global script for a device match node",
