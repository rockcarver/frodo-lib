            "        field("username", rawProfile.elements.get(0).get("handle~").emailAddress)))",
          ],
        },
        "8e298710-b55e-4085-a464-88a375a4004b": {
          "_id": "8e298710-b55e-4085-a464-88a375a4004b",
          "context": "SOCIAL_IDP_PROFILE_TRANSFORMATION",
