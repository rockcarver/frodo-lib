          "}",
          "",
          "function getPasswordCallback() {",
          "    setProperty(callbacks.getPasswordCallbacks().get(0));",
          "}",
          "",
          "function getSelectIdPCallback() {",
          "    setProperty(callbacks.getSelectIdPCallbacks().get(0));",
          "}",
          "",
          "function getStringAttributeInputCallback() {",
