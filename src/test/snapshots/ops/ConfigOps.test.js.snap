            case CALLBACKS.CHOICE_CALLBACK: getChoiceCallback(); break;
            case CALLBACKS.CONFIRMATION_CALLBACK: getConfirmationCallback(); break;
            case CALLBACKS.CONSENT_MAPPING_CALLBACK: getConsentMappingCallback(); break;
