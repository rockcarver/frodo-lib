          },
          {
            "condition": "/object/country  pr",
            "source": "country",
            "target": "country",
          },
          {
            "condition": "/object/phone  pr",
            "source": "phone",
            "target": "telephoneNumber",
          },
          {
            "source": "username",
            "target": "userName",
          },
        ],
