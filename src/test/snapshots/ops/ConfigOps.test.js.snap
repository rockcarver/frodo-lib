function isStringPresent(value) {
    return value;
}

function getString(value) {
    return value || '';
}

function isArrayPresent(value) {
    return value;
}

function getArray(value) {
    return value ? JSON.parse(value) : [];
}

function isObjectPresent(value) {
    return value;
}

function getObject(value) {
    return value ? JSON.parse(value) : {};
}

