        "_id": "apiVersion",
        "warning": {
          "enabled": {
            "$bool": "&{openidm.apiVersion.warning.enabled|false}",
          },
          "includeScripts": {
            "$bool": "&{openidm.apiVersion.warning.includeScripts|false}",
          },
          "logFilterResourcePaths": [
            "audit",
            "authentication",
            "cluster",
            "config",
            "consent",
            "csv",
            "external/rest",
            "identityProviders",
            "info",
            "internal",
            "internal/role",
            "internal/user",
            "internal/usermeta",
            "managed",
            "managed/assignment",
            "managed/organization",
            "managed/role",
