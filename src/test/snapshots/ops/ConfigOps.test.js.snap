                  "escalation": {
                    "actors": [
                      {
                        "id": {
                          "isExpression": true,
                          "value": [
                            "violation.policyRule.violationOwner.id",
                          ],
                        },
                        "permissions": {
                          "allow": true,
                          "comment": true,
                          "exception": true,
                          "reassign": true,
                          "remediate": true,
                        },
                      },
                    ],
                    "date": {
