      "script": {
        "01e1a3c0-038b-4c16-956a-6c9d89328cff": {
          "_id": "01e1a3c0-038b-4c16-956a-6c9d89328cff",
          "context": "AUTHENTICATION_TREE_DECISION_NODE",
