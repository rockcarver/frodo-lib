{
  "name": "@rockcarver/frodo-lib",
  "version": "5.0.0-5",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./types/*": "./types/*"
  },
  "files": [
    "dist",
    "types",
    "scripts/patch-axios-types.cjs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "npm run test:only",
    "test:only": "NODE_OPTIONS=--experimental-vm-modules npx jest --silent",
    "test:debug": "NODE_OPTIONS=--experimental-vm-modules npx jest --silent=false",
    "test:record": "NODE_OPTIONS=--experimental-vm-modules FRODO_POLLY_MODE=record npx jest --silent=false --runInBand --updateSnapshot",
    "test:record_noauth": "NODE_OPTIONS=--experimental-vm-modules FRODO_POLLY_MODE=record_noauth npx jest --silent=false --updateSnapshot --testPathIgnorePatterns cjs",
    "test:update": "NODE_OPTIONS=--experimental-vm-modules npx jest --silent=false --updateSnapshot",
    "mcp:contract-gap-summary": "node scripts/mcp-contract-gap-summary.mjs",
    "lint": "npm run check",
    "lint:fix": "npm run fix",
    "fix": "eslint --fix \"src/**/*.ts\" && prettier --write \"src/**/*.ts\"",
    "check": "eslint \"src/**/*.ts\" && prettier --check \"src/**/*.ts\"",
    "clean-types": "rimraf types",
    "generate-types": "tsc && node scripts/deprecate-types-subpath.cjs",
    "generate-help": "node scripts/generate-help.mjs",
    "build": "npm run generate-help && npx tsdown && npm run clean-types && npm run generate-types",
    "doc": "npx typedoc",
    "prettier:fix": "prettier --write \"src/**/*.ts\"",
    "dev": "npx tsdown --watch src --onSuccess 'npx tsdown --dts-only'",
    "postinstall": "node scripts/patch-axios-types.cjs"
  },
  "description": "A library to manage ForgeRock Identity Cloud tenants, ForgeOps deployments, and classic deployments.",
  "keywords": [
    "ping",
    "pingone",
    "forgerock",
    "library",
    "am",
    "openam",
    "idm",
    "openidm",
    "forgeops",
    "identity cloud",
    "advanced identity cloud",
    "export",
    "import",
    "ci/cd",
    "devops"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rockcarver/frodo-lib.git"
  },
  "bugs": {
    "url": "https://github.com/rockcarver/frodo-lib/issues"
  },
  "contributors": [
    {
      "name": "Conor Barford",
      "email": "conor.barford@pingidentity.com"
    },
    {
      "name": "Sandeep Chaturvedi",
      "email": "sandeep.chaturvedi@forgerock.com"
    },
    {
      "name": "Huston Franklin",
      "email": "hfranklin@trivir.com"
    },
    {
      "name": "Preston Hales",
      "email": "phales@trivir.com"
    },
    {
      "name": "Joshua Sayers",
      "email": "joshua.sayers@forgerock.com"
    },
    {
      "name": "Volker Scheuber",
      "email": "volker.scheuber@forgerock.com"
    }
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@jest/globals": "^30.2.0",
    "@peculiar/x509": "2.1.0",
    "@pollyjs/adapter-node-http": "^6.0.5",
    "@pollyjs/core": "^6.0.5",
    "@pollyjs/persister-fs": "^6.0.5",
    "@types/fs-extra": "^11.0.1",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.14.189",
    "@types/mock-fs": "^4.13.1",
    "@types/node": "^26.6.3",
    "@types/pluralize": "^0.0.33",
    "@types/properties-reader": "^2.1.1",
    "@types/uuid": "^10.0.0",
    "acorn": "8.18.0",
    "agentkeepalive": "^4.2.1",
    "axios": "^1.13.4",
    "axios-mock-adapter": "^2.1.0",
    "axios-retry": "^4.4.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "fastest-levenshtein": "^1.0.16",
    "fs-extra": "^11.1.1",
    "jest": "^30.2.0",
    "jest-jasmine2": "^30.2.0",
    "jose": "6.2.12",
    "loglevel": "^1.9.1",
    "mock-fs": "^5.2.0",
    "pluralize": "^8.0.0",
    "prettier": "3.9.9",
    "properties-reader": "^3.0.1",
    "proxy-agent": "^6.5.0",
    "qs": "^6.16.0",
    "reflect-metadata": "0.2.2",
    "rimraf": "^6.0.1",
    "setup-polly-jest": "^0.11.0",
    "slugify": "^1.6.5",
    "sshpk": "^1.18.0",
    "tinyrainbow": "^3.0.3",
    "ts-jest": "^29.1.2",
    "tsdown": "0.23.0",
    "typedoc": "^0.28.16",
    "typedoc-plugin-missing-exports": "^4.1.2",
    "typescript": "5.9",
    "typescript-eslint": "8.71.0",
    "uuid": "^14.0.2",
    "winston": "^3.19.0"
  },
  "overrides": {
    "basic-ftp": "6.2.1",
    "argparse": "^2.0.1"
  }
}
